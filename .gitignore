# Visual Studio 2015 user specific files
.vs/

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Stream Deck plugin build output
ControlDeck/com.porisius.satisfactorycontrolpanel.sdPlugin/bin/
ControlDeck/*.map

# Optional archives
*.zip
*.streamDeckPlugin

# Node
ControlDeck/node_modules/
ControlDeck/npm-debug.log*
ControlDeck/yarn-debug.log*
ControlDeck/yarn-error.log*
ControlDeck/pnpm-debug.log*

# Build output
ControlDeck/dist/
ControlDeck/build/
ControlDeck/coverage/